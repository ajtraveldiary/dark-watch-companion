{
  // Static site served by Cloudflare Workers (Static Assets). No server code needed.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dark-watch-companion",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./public",
    "not_found_handling": "single-page-application"
  }
}
