{
  // Static site + a small Worker that stores shared character photos in R2.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dark-watch-companion",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/photos/*"]
  },
  "r2_buckets": [
    { "binding": "PHOTOS", "bucket_name": "dark-watch-photos" }
  ],
  // Visitor counter: one SQLite-backed Durable Object (no separate database to create)
  "durable_objects": {
    "bindings": [{ "name": "VISITS", "class_name": "VisitCounter" }]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["VisitCounter"] }
  ],
  // Rate limits, per Cloudflare location. They stop floods before they reach the counter.
  "ratelimits": [
    { "name": "VISIT_LIMIT",  "namespace_id": "41001", "simple": { "limit": 5,   "period": 60 } },
    { "name": "READ_LIMIT",   "namespace_id": "41002", "simple": { "limit": 30,  "period": 60 } },
    { "name": "VISIT_GLOBAL", "namespace_id": "41003", "simple": { "limit": 300, "period": 60 } },
    { "name": "OWNER_LIMIT",  "namespace_id": "41004", "simple": { "limit": 60,  "period": 60 } }
  ]
  // Secret (not in this file): ADMIN_KEY – the owner key that allows uploading and removing photos.
  // Set it with `npx wrangler secret put ADMIN_KEY`, or add a PHOTO_ADMIN_KEY secret to the GitHub repo
  // and the deploy workflow sets it for you.
}
